# Copy this file to .env (same folder) and fill in real values. Never commit .env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sti_cctv_portal
DB_USER=sti_app
DB_PASS=change_me

# 32-byte key (base64) used to encrypt stored NVR/camera device credentials
# generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_base64_32byte_key

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=8080
WS_STATUS_POLL_SECONDS=30

# Public URL of the websocket server that the browser will connect to
# e.g. ws://cctv.sti.edu.ph:8080  or  wss://cctv.sti.edu.ph:8080 behind TLS
WS_PUBLIC_URL=ws://localhost:8080
